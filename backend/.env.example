# Current prisma/schema.prisma expects PostgreSQL (Supabase in production).
# For local SQLite: copy prisma/schema.sqlite.prisma over prisma/schema.prisma, then use only:
#   DATABASE_URL="file:./dev.db"
# (omit DIRECT_URL — the sqlite schema does not define it)

# Local Postgres (both URLs the same if you are not using a pooler):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apollo?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apollo?schema=public"

# Production (Supabase project: alpha-polymers / nxsaoglxjfgmfflrposk) — Dashboard → Connect:
# DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true
# DIRECT_URL   = Direct or Session pooler (port 5432)
# DATABASE_URL="postgresql://postgres.nxsaoglxjfgmfflrposk:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.nxsaoglxjfgmfflrposk:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
# (or DIRECT_URL="postgresql://postgres:PASSWORD@db.nxsaoglxjfgmfflrposk.supabase.co:5432/postgres")

# REQUIRED: long random string (32+ chars). Generate with: openssl rand -base64 48
# Never commit the real value.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

FRONTEND_URL="http://localhost:3000"
PORT=4000
NODE_ENV="development"

# Optional email delivery for password resets (and future transactional mail).
# Prefer Resend; otherwise SMTP. If neither is set, reset links are logged to the server console.
MAIL_FROM="Alpha Polymers <noreply@yourdomain.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=
SMTP_PASS=

# REQUIRED for seeding the admin user (no defaults in code).
# Password rules: 12+ chars, upper, lower, number, special character.
ADMIN_EMAIL="your-admin@example.com"
ADMIN_PASSWORD="ReplaceWithAStrongPass1!"

# Set to "true" only when you intentionally want seed to overwrite the admin password.
SEED_RESET_ADMIN_PASSWORD="false"

# Stripe payments (paste your keys when ready)
# Dashboard → Developers → API keys
# Use sk_test_… locally; sk_live_… in production.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint:
#   https://YOUR_API_HOST/api/orders/stripe-webhook
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Production: leave unset/false. Demo checkout only for local testing without Stripe keys.
ALLOW_DEMO_CHECKOUT="true"
