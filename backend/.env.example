# Local (SQLite) — works out of the box
DATABASE_URL="file:./dev.db"

# Production on Render (PostgreSQL) — after changing schema provider to postgresql:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# REQUIRED: long random string (32+ chars). Generate with: openssl rand -base64 48
# Never commit the real value.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

FRONTEND_URL="http://localhost:3000"
PORT=4000
NODE_ENV="development"

# Optional email delivery for password resets (and future transactional mail).
# Prefer Resend; otherwise SMTP. If neither is set, reset links are logged to the server console.
MAIL_FROM="Alpha Polymers <noreply@yourdomain.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=
SMTP_PASS=

# REQUIRED for seeding the admin user (no defaults in code).
# Password rules: 12+ chars, upper, lower, number, special character.
ADMIN_EMAIL="your-admin@example.com"
ADMIN_PASSWORD="ReplaceWithAStrongPass1!"

# Set to "true" only when you intentionally want seed to overwrite the admin password.
SEED_RESET_ADMIN_PASSWORD="false"

# Stripe payments (paste your keys when ready)
# Dashboard → Developers → API keys
# Use sk_test_… locally; sk_live_… in production.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint:
#   https://YOUR_API_HOST/api/orders/stripe-webhook
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Production: leave unset/false. Demo checkout only for local testing without Stripe keys.
ALLOW_DEMO_CHECKOUT="true"
