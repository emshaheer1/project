# Copy to backend/.env and fill in real values.
# Never commit .env — it is gitignored.

# Local SQLite: copy prisma/schema.sqlite.prisma over prisma/schema.prisma, then:
# DATABASE_URL="file:./dev.db"
# (omit DIRECT_URL)

# Local Postgres:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"

# Production Postgres (set real URLs in the host dashboard, not in git):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

FRONTEND_URL="http://localhost:3000"
PORT=4000
NODE_ENV="development"

MAIL_FROM="Store <noreply@example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=
SMTP_PASS=

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

SEED_RESET_ADMIN_PASSWORD="false"

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ALLOW_DEMO_CHECKOUT="true"
