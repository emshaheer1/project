NEXT_PUBLIC_API_URL=http://localhost:4000
# Supabase (catalog reads — Product SELECT via anon key + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional — only needed if you later embed Stripe Elements on-site.
# Hosted Checkout (current flow) uses STRIPE_SECRET_KEY on the API only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
